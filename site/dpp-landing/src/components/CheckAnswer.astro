---
// CheckAnswer.astro — one answer of the passport check.
//
// Used by /passport-check (light) and by the picker in the home page's hero
// (dark), so both say exactly the same thing: the answer itself comes from
// lib/checker.ts, and only the ground it sits on differs.
//
// The hero's answer also carries the next steps, because the home page is
// where a visitor arrives with no context: the product group's checklist, an
// email to us, and a link to the full check for sharing. /passport-check has
// its own next-step section, so its card stays as it was.
import BasisMark from "./BasisMark.astro";
import Button from "./Button.astro";
import { basisLabel } from "../lib/regulations";
import { MAILBOX, mailto } from "../lib/lead";
import { checklistFor, type Card } from "../lib/checker";

interface Props {
  card: Card;
  /** `light` on /passport-check, `dark` in the home page's navy hero. */
  tone?: "light" | "dark";
}
const { card, tone = "light" } = Astro.props;
const a = card.answer;

const lightBox = {
  yes: "border-regulatory-border bg-regulatory-bg",
  later: "border-primary-200 bg-primary-50",
  no: "border-neutral-200 bg-white",
};
// On navy the verdict is carried by the headline's words; the left rule only
// echoes it (amber where a date is set, ice where one is coming).
const darkRule = {
  yes: "border-l-regulatory-border",
  later: "border-l-primary-300",
  no: "border-l-primary-300/30",
};
const checklist = checklistFor(card);
---

{tone === "light" ? (
  <li data-answer={card.key} class:list={["m-0 max-w-2xl rounded-md border p-5", lightBox[a.verdict]]}>
    <p class="m-0 text-xs font-semibold uppercase tracking-wide text-neutral-500">{card.label}</p>
    <p class="m-0 mt-1.5 text-xl font-semibold leading-snug text-neutral-900">{a.headline}</p>
    <p class="m-0 mt-2 text-sm leading-body text-neutral-700">{a.detail}</p>
    <p class="m-0 mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {a.basis && <BasisMark basis={a.basis} label={basisLabel(a.basis)} />}
      {a.links.map((l) => <a href={l.href} class="link-arrow">{l.label}</a>)}
    </p>
  </li>
) : (
  <li
    data-answer={card.key}
    class:list={["m-0 mt-5 rounded-lg border border-l-4 border-primary-300/20 bg-primary-900/70 p-5", darkRule[a.verdict]]}
  >
    <p class="m-0 text-xs font-semibold uppercase tracking-wide text-primary-300">{card.label}</p>
    <p class="m-0 mt-1.5 text-lg font-semibold leading-snug text-white">{a.headline}</p>
    <p class="m-0 mt-2 text-sm leading-body text-primary-100">{a.detail}</p>
    <p class="m-0 mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {a.basis && <BasisMark basis={a.basis} label={basisLabel(a.basis)} tone="dark" />}
      {a.links.map((l) => <a href={l.href} class="link-arrow text-primary-200 hover:text-white">{l.label}</a>)}
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      {checklist && (
        <Button href={checklist} tone="dark" size="md" arrow>
          Open the checklist
        </Button>
      )}
      <Button href={mailto("home", card.label)} tone="dark" variant="secondary" size="md">Email us about this</Button>
    </div>
    <p class="m-0 mt-3 text-xs leading-body text-primary-300">
      Or write to <span class="select-all text-primary-100">{MAILBOX}</span>. A first answer, not legal
      advice.{" "}
      <a href={`/passport-check#${card.key}`} class="text-primary-200 underline hover:text-white">Share this answer</a>
    </p>
  </li>
)}

<!-- Global, not scoped: a scoped rule only reaches elements of the component
     that declares it, and the pages that list these answers are other
     components. The script reveals the chosen answer by marking it
     `data-shown` (lib/checker-client.ts); a <noscript> style may override. -->
<style is:global>
  [data-answer]:not([data-shown]) {
    display: none;
  }
</style>
