---
// Roadmap.astro — the four registers, each grouped into themes.
// Data lives in src/data/roadmap.json, so editors change JSON, not markup.
//
// WHY FOUR REGISTERS AND NOT THREE
//
// "Waiting on a legal step" is kept apart from "In progress" on purpose. The
// seal and registry work is finished; what holds it back is that only a legal
// person may create an electronic seal. Filing that under "in progress" would
// turn a legal fact into an engineering schedule.
//
// Items describe capabilities in plain words. Routes, commands and version
// numbers belong on the docs site, never here.
import data from "../data/roadmap.json";

type Status = "available" | "waiting" | "in-progress" | "considered";
type Item = {
  title: string;
  line: string;
  variants?: string[];
  link?: { href: string; label: string };
};
type Theme = { theme: string; items: Item[] };
type Register = { status: Status; title: string; description: string; themes: Theme[] };

const { registers } = data as unknown as { registers: Register[] };

const tone: Record<Status, { dot: string; rule: string; chip: string }> = {
  available: {
    dot: "bg-status-released",
    rule: "border-status-released/30",
    chip: "bg-primary-50 text-primary-800",
  },
  waiting: {
    dot: "bg-status-blocked",
    rule: "border-status-blocked/40",
    chip: "bg-neutral-100 text-neutral-700",
  },
  "in-progress": {
    dot: "bg-status-active",
    rule: "border-status-active/30",
    chip: "bg-neutral-100 text-neutral-700",
  },
  considered: {
    dot: "bg-status-development",
    rule: "border-neutral-200",
    chip: "bg-neutral-100 text-neutral-700",
  },
};

const count = (r: Register) => r.themes.reduce((n, t) => n + t.items.length, 0);
---

<nav aria-label="Roadmap sections" class="mb-12 flex flex-wrap gap-2">
  {registers.map((reg) => (
    <a
      href={`#${reg.status}`}
      class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3.5 py-1.5 text-sm font-medium text-neutral-800 no-underline transition-colors hover:border-primary-300 hover:no-underline"
    >
      <span class={`h-2 w-2 rounded-full ${tone[reg.status].dot}`} aria-hidden="true"></span>
      {reg.title}
      <span class="text-neutral-500">{count(reg)}</span>
    </a>
  ))}
</nav>

<div class="space-y-16">
  {registers.map((reg) => (
    <section id={reg.status} aria-labelledby={`reg-${reg.status}`} class="scroll-mt-24">
      <header class={`border-b pb-4 ${tone[reg.status].rule}`}>
        <h3 id={`reg-${reg.status}`} class="m-0 flex items-center gap-2.5 text-xl font-bold text-neutral-900">
          <span class={`inline-block h-2.5 w-2.5 shrink-0 rounded-full ${tone[reg.status].dot}`} aria-hidden="true"></span>
          {reg.title}
        </h3>
        <p class="m-0 mt-2 max-w-3xl text-sm leading-relaxed text-neutral-600">{reg.description}</p>
      </header>

      <div class="mt-8 space-y-10">
        {reg.themes.map((theme) => (
          <div class:list={["grid gap-x-8 gap-y-4", { "md:grid-cols-[12rem_1fr]": reg.themes.length > 1 }]}>
            {reg.themes.length > 1 && (
              <h4 class="m-0 text-sm font-semibold text-neutral-900 md:pt-5">{theme.theme}</h4>
            )}
            <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2">
              {theme.items.map((it) => (
                <li class="card m-0 flex flex-col p-5">
                  <p class="m-0 font-semibold text-neutral-900">{it.title}</p>
                  <p class="m-0 mt-1.5 text-sm leading-relaxed text-neutral-600">{it.line}</p>
                  {it.variants && (
                    <ul class="m-0 mt-3 flex list-none flex-wrap gap-1.5 p-0" aria-label="Variants">
                      {it.variants.map((v) => (
                        <li class={`m-0 rounded-md px-2 py-0.5 text-xs font-medium ${tone[reg.status].chip}`}>{v}</li>
                      ))}
                    </ul>
                  )}
                  {it.link && (
                    <p class="m-0 mt-auto pt-3 text-sm">
                      <a href={it.link.href} class="link-arrow">{it.link.label}</a>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>
