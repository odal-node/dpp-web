---
// FlowDiagram.astro — how a passport is made, and who touches it.
//
// The home page's five steps (Import, Validate, Sign, Publish, Verify), placed
// in the three places they happen: on the operator's infrastructure, on the
// web, and wherever someone checks a passport. A dashed lane below says Odal is
// in none of them. That is a statement about how the software is built (the
// node runs on the operator's infrastructure and there is no channel to us),
// the same one /trust makes; it is not a runtime guarantee we monitor.
//
// HTML, not an SVG picture: the text reflows at any width and a screen reader
// reads it as three labelled lists of numbered steps. The arrows between the
// places are decoration and hidden from assistive technology.
//
// Deliberately absent: a transfer signed by two parties (the node signs the
// acceptance, not the incoming company), "discarded" inputs (the node may
// keep what the law asks to be kept), and the EU registry (built, but waiting
// on a legal step).
type Step = { n: number; label: string; body: string };
type Zone = { label: string; icon: string; steps: Step[]; notes?: string[]; strong?: boolean };

const zones: Zone[] = [
  {
    label: "On your infrastructure",
    icon: '<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/>',
    strong: true,
    steps: [
      { n: 1, label: "Import", body: "Product data from CSV or Excel, including exports from your ERP." },
      { n: 2, label: "Validate", body: "Against each product group's rules, on your own node." },
      { n: 3, label: "Sign", body: "With your own key, generated and held on your infrastructure." },
    ],
    notes: ["Everything the node stores stays here, and so does your signing key, encrypted at rest."],
  },
  {
    label: "On the web",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z"/>',
    steps: [
      { n: 4, label: "Publish", body: "The signed passport becomes resolvable through its QR code and GS1 Digital Link." },
    ],
    notes: [
      "Anyone reads the public part.",
      "Repairers, recyclers and authorities read the restricted parts, on a verified credential.",
    ],
  },
  {
    label: "Anyone, anywhere",
    icon: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
    steps: [
      { n: 5, label: "Verify", body: "Anyone checks the signature against the identity on your web domain, even offline, without Odal." },
    ],
  },
];
---

<div class="not-prose">
  <div class="flow grid items-stretch gap-3 lg:gap-0">
    {zones.map((z, i) => (
      <>
        {i > 0 && (
          <div class="flow-arrow flex items-center justify-center text-primary-400" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 rotate-90 lg:rotate-0">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </div>
        )}
        <section
          aria-label={z.label}
          class:list={[
            "flex flex-col rounded-xl bg-white p-5",
            z.strong ? "border-2 border-primary-500" : "border border-neutral-200",
          ]}
        >
          <p class="m-0 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-primary-700">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true" set:html={z.icon} />
            {z.label}
          </p>
          <ol start={z.steps[0].n} class="m-0 mt-4 grid list-none gap-4 p-0">
            {z.steps.map((s) => (
              <li class="m-0 flex gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-primary-500 text-xs font-semibold text-primary-700" aria-hidden="true">
                  {s.n}
                </span>
                <span>
                  <span class="block text-sm font-semibold text-neutral-900">{s.label}</span>
                  <span class="mt-0.5 block text-sm leading-body text-neutral-600">{s.body}</span>
                </span>
              </li>
            ))}
          </ol>
          {z.notes && (
            <div class="mt-auto pt-4">
              <ul class="m-0 list-none space-y-1.5 border-t border-neutral-200 p-0 pt-3 text-xs leading-body text-neutral-600">
                {z.notes.map((n) => <li class="m-0">{n}</li>)}
              </ul>
            </div>
          )}
        </section>
      </>
    ))}
  </div>

  <p class="m-0 mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border border-dashed border-neutral-300 px-5 py-3 text-sm text-neutral-600">
    <span class="font-semibold text-neutral-900">Odal</span>
    <span>Not in this path. Your product data never reaches us.</span>
  </p>
</div>

<style>
  /* Three places and two arrows in one row from lg up; stacked below. */
  @media (min-width: 64rem) {
    .flow {
      grid-template-columns: minmax(0, 1.35fr) 2.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr);
    }
  }
</style>
