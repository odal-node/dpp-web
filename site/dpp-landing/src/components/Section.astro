---
// Section.astro — a standard content section with an eyebrow, title, and slot.
// Tones: default = white, muted = warm grey, tinted = ice.
//
// The eyebrow now carries a short rule. An uppercase line of 10px letters with
// nothing beside it reads as a stray label; the rule turns it into a marker and
// gives the eye something to start the section on.
//
// Headings step up a size at `md` — at 3xl on a 1440px screen a section title
// sat at almost the same weight as the body around it, which is what made the
// long pages feel flat.
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  tone?: "default" | "muted" | "tinted";
  /** Widen the inner container for grid-heavy sections. */
  wide?: boolean;
}
const { eyebrow, title, id, tone = "default", wide = false } = Astro.props;
const bg =
  tone === "muted" ? "bg-neutral-50" : tone === "tinted" ? "bg-primary-50" : "bg-transparent";
const width = wide ? "max-w-6xl" : "max-w-5xl";

// A section given an id is a section something links to, so its heading gets
// the id and becomes the anchor target rather than the band around it —
// otherwise the browser scrolls to the top of the padding and the title lands
// off screen.
const headingId = id ? `${id}-title` : undefined;
---

<section id={id} aria-labelledby={headingId} class={`${bg} py-16 md:py-24`}>
  <div class={`${width} mx-auto px-4 sm:px-6 lg:px-8`}>
    {eyebrow && (
      <p class="mb-3 flex items-center gap-2.5 text-xs font-semibold uppercase tracking-widest text-primary-500">
        <span class="h-px w-6 shrink-0 bg-primary-400/50" aria-hidden="true"></span>
        {eyebrow}
      </p>
    )}
    <h2 id={headingId} class="mb-6 max-w-3xl text-3xl font-bold text-neutral-900 md:text-4xl">
      {title}
    </h2>
    <div class="prose prose-neutral max-w-none leading-body">
      <slot />
    </div>
  </div>
</section>
