---
// Nav.astro — top navigation. Mark + wordmark left; five menus, Docs and the
// CTA right.
//
// Five menus, in this order, each answering one question: "How it works" (what
// the software does), "Compliance" (what the law requires of my product, and
// when), "Developers" (how to build on it), "Resources" (is it ready, what does
// this word mean, how do I report a flaw) and "Product groups". Split this way
// on 2026-09-26 at the founder's choice, when "Resources" had grown to seven
// items; "Product groups" and the Docs link were kept exactly as they were.
//
// Each is a disclosure (a button that shows and hides a panel), not an ARIA
// menu: the panels hold ordinary links, and a screen reader should read them as
// links. The first four are small panels under their buttons, rendered from one
// template. "Product groups" is a full-width panel, because eleven groups with
// a line each do not fit under a button.
//
// The bar appears from `xl` (1280px). Five menus, Docs and the CTA beside the
// wordmark measured about 1,100px on 2026-09-26, and at 1024px "How it works"
// and "Product groups" wrapped onto two lines. Below `xl` the hamburger panel
// carries the same five sections.
//
// All open on hover for a mouse and on click or Enter for everyone else, close
// on Escape and on a click outside, and only one is ever open.
//
// The product-group wording comes from product-group-copy.json, never from the
// vendored manifests, so the menu reads the same as every other list of groups
// on the site.
import StatusBadge from "./StatusBadge.astro";
// The real brand mark (currentColor variant of odal-mark), so the nav stays in
// sync with the brand asset and the mark inherits the wordmark's colour.
import OdalMark from "../assets/favicon.svg";
import ExternalArrow from "./ExternalArrow.astro";
import Button from "./Button.astro";
import ProductGroupIcon from "./ProductGroupIcon.astro";
import { groups, unsoldGoods as unsold } from "../lib/product-groups";

type Entry = { href: string; label: string; line: string; icon: string; external?: boolean };

const howItWorks: Entry[] = [
  {
    href: "/lifecycle",
    label: "Lifecycle",
    line: "Follow one passport from the factory to the end of its life",
    icon: '<path d="M4 12a8 8 0 0 1 13.66-5.66L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.66 5.66L4 15.5"/><path d="M4 20v-4.5h4.5"/>',
  },
  {
    href: "/visibility",
    label: "Visibility",
    line: "Who can read which part of a passport, and why",
    icon: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    href: "/example-passport",
    label: "Example passport",
    line: "A complete battery passport, sorted by who may read it",
    icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  },
  {
    href: "/verify",
    label: "Verify",
    line: "Check a passport's proof file in your browser",
    icon: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  },
  {
    href: "/trust",
    label: "What Odal can see",
    line: "What stays on your node, and why that holds by design",
    icon: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  },
];

const compliance: Entry[] = [
  {
    href: "/passport-check",
    label: "Passport check",
    line: "Does your product need a passport, and from when",
    icon: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  },
  {
    href: "/timeline",
    label: "Timeline",
    line: "When each passport is required, year by year",
    icon: '<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
  },
  {
    href: "/regulations",
    label: "Regulations",
    line: "The EU acts behind the passports, and when each applies",
    icon: '<path d="M12 3v18M5 21h14"/><path d="M5 7h14"/><path d="m5 7-2.5 6a2.5 2.5 0 0 0 5 0L5 7ZM19 7l-2.5 6a2.5 2.5 0 0 0 5 0L19 7Z"/>',
  },
];

const developers: Entry[] = [
  {
    href: "/build-on-odal",
    label: "Build on Odal",
    line: "Libraries, plugins and the licence line",
    icon: '<path d="m8 8-5 4 5 4M16 8l5 4-5 4M13.5 5l-3 14"/>',
  },
  {
    href: "https://docs.odal-node.io",
    label: "Documentation",
    line: "Install, run and operate a node",
    icon: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5v-13Z"/>',
    external: true,
  },
  {
    href: "https://docs.odal-node.io/api",
    label: "API reference",
    line: "Every route a node serves",
    icon: '<path d="M8 4H7a2 2 0 0 0-2 2v4l-2 2 2 2v4a2 2 0 0 0 2 2h1M16 4h1a2 2 0 0 1 2 2v4l2 2-2 2v4a2 2 0 0 1-2 2h-1"/>',
    external: true,
  },
];

const resources: Entry[] = [
  {
    href: "/roadmap",
    label: "Roadmap",
    line: "What is built, what is waiting and what comes next",
    icon: '<path d="M5 21V4"/><path d="M5 4.5h11l-2 3.5 2 3.5H5"/>',
  },
  {
    href: "/faq",
    label: "FAQ",
    line: "Short answers to the questions people ask first",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5v.7"/><path d="M12 17h.01"/>',
  },
  {
    href: "/glossary",
    label: "Glossary",
    line: "The words around a passport, explained",
    icon: '<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5v-15Z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19"/><path d="M9 8h6M9 11h4"/>',
  },
  {
    href: "/security",
    label: "Security",
    line: "Report an issue, and how passports and keys are protected",
    icon: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="M12 8v5M12 16h.01"/>',
  },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const within = (list: Entry[]) => list.some((e) => path === e.href || path.startsWith(`${e.href}/`));
const inGroups = path.startsWith("/product-groups");

// The four small menus, in bar order; "Product groups" follows them.
const small = [
  { id: "dd-how", label: "How it works", items: howItWorks },
  { id: "dd-compliance", label: "Compliance", items: compliance },
  { id: "dd-developers", label: "Developers", items: developers },
  { id: "dd-resources", label: "Resources", items: resources },
].map((m) => ({ ...m, current: within(m.items) }));
---

<header class="sticky top-0 z-50 border-b border-neutral-100 bg-gray-100">
  <nav class="mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-6" aria-label="Main">
    <a href="/" class="site-title flex items-center gap-6 font-semibold tracking-tight text-primary-800 no-underline hover:no-underline">
      <OdalMark aria-hidden="true" class="h-8 w-8 shrink-0 md:h-10 md:w-10" />
      <span class="text-xl md:text-2xl tracking-normal">Odal Node</span>
    </a>

    <!-- desktop -->
    <div class="hidden items-center gap-1 xl:flex">
      {small.map((m) => (
        <div class="dd relative" data-dd>
          <button
            type="button"
            class:list={["dd-trigger", { "is-current": m.current }]}
            aria-expanded="false"
            aria-controls={m.id}
          >
            {m.label}
            <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div id={m.id} class={`dd-panel absolute left-0 top-full mt-3 w-88 rounded-xl border border-neutral-200 bg-white p-2 shadow-xl shadow-primary-900/10`}>
            <ul class="m-0 list-none p-0">
              {m.items.map((e) => (
                <li class="m-0">
                  <a
                    href={e.href}
                    rel={e.external ? "noopener" : undefined}
                    aria-current={path === e.href ? "page" : undefined}
                    class="dd-item group flex items-start gap-3 rounded-lg p-3 no-underline hover:no-underline"
                  >
                    <span class="dd-tile">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5" set:html={e.icon} />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-neutral-900">{e.label}{e.external && <ExternalArrow class="ml-1" />}</span>
                      <span class="mt-0.5 block text-xs leading-snug text-neutral-500">{e.line}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <!-- Not `relative`: the panel positions against the header, full width. -->
      <div class="dd" data-dd>
        <button
          type="button"
          class:list={["dd-trigger", { "is-current": inGroups }]}
          aria-expanded="false"
          aria-controls="dd-groups"
        >
          Product groups
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <div id="dd-groups" class="dd-panel dd-mega absolute inset-x-0 top-full border-y border-neutral-200 bg-white shadow-xl shadow-primary-900/10">
          <div class="mx-auto grid max-w-6xl gap-6 px-6 py-6 lg:grid-cols-[1fr_17rem]">
            <div>
              <p class="m-0 mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-primary-700">Product groups</p>
              <ul class="m-0 grid list-none gap-1 p-0 sm:grid-cols-2 lg:grid-cols-3">
                {groups.map((g) => (
                  <li class="m-0">
                    <a
                      href={`/product-groups/${g.key}`}
                      aria-current={path === `/product-groups/${g.key}` ? "page" : undefined}
                      class="dd-item group flex items-start gap-3 rounded-lg p-3 no-underline hover:no-underline"
                    >
                      <span class="dd-tile">
                        <ProductGroupIcon group={g.key} class="h-5 w-5" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold text-neutral-900">{g.name}</span>
                        <span class="mt-0.5 block text-xs leading-snug text-neutral-500">{g.line}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <aside class="flex flex-col rounded-xl bg-primary-900 p-5 text-primary-200">
              <p class="m-0 text-xs font-semibold uppercase tracking-widest text-primary-300">Also covered</p>
              <a
                href="/product-groups/unsold-goods"
                class="group mt-3 flex items-start gap-3 rounded-lg p-2 -mx-2 no-underline hover:bg-white/5 hover:no-underline"
              >
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-white/10 text-primary-200 transition-colors group-hover:bg-primary-300 group-hover:text-primary-900">
                  <ProductGroupIcon group="unsold-goods" class="h-5 w-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-white">{unsold.name}</span>
                  <span class="mt-0.5 block text-xs leading-snug text-primary-300">{unsold.line}</span>
                </span>
              </a>
              <p class="m-0 mt-4 text-xs leading-relaxed text-primary-300/90">
                Pick a group to see what its passport carries and who may read
                each part of it.
              </p>
              <a href="/product-groups" class="link-arrow mt-auto pt-4 text-sm font-semibold text-white">
                All product groups
              </a>
            </aside>
          </div>
        </div>
      </div>

      <a
        href="https://docs.odal-node.io"
        rel="noopener"
        class="rounded-md px-3 py-2 text-sm font-medium text-neutral-600 no-underline hover:bg-neutral-200/60 hover:text-neutral-900"
      >
        Docs<ExternalArrow class="ml-1" />
      </a>
      <Button href="/waitlist" class="ml-2">Join the waitlist</Button>
    </div>

    <!-- mobile hamburger -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-neutral-700 hover:bg-neutral-100 xl:hidden"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <!-- mobile panel: the five menus become collapsible sections -->
  <div id="nav-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-neutral-200 bg-white px-4 pb-4 pt-2 xl:hidden">
    <div class="px-3 pb-2 pt-1">
      <StatusBadge tone="light" label="Alpha · in active development" />
    </div>

    {small.map((m) => (
      <details class="m-section" open={m.current}>
        <summary>{m.label}</summary>
        <ul class="m-0 list-none p-0 pb-2">
          {m.items.map((e) => (
            <li class="m-0">
              <a href={e.href} rel={e.external ? "noopener" : undefined} class="block rounded-md px-3 py-2 text-sm text-neutral-700 no-underline hover:bg-neutral-100">
                <span class="font-medium text-neutral-900">{e.label}{e.external && <ExternalArrow class="ml-1" />}</span>
                <span class="block text-xs text-neutral-500">{e.line}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}

    <details class="m-section" open={inGroups}>
      <summary>Product groups</summary>
      <ul class="m-0 grid list-none grid-cols-2 gap-1 p-0 pb-2">
        {groups.map((g) => (
          <li class="m-0">
            <a href={`/product-groups/${g.key}`} class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-neutral-800 no-underline hover:bg-neutral-100">
              <ProductGroupIcon group={g.key} class="h-4 w-4 shrink-0 text-primary-700" />
              {g.name}
            </a>
          </li>
        ))}
        <li class="col-span-2 m-0">
          <a href="/product-groups/unsold-goods" class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-neutral-800 no-underline hover:bg-neutral-100">
            <ProductGroupIcon group="unsold-goods" class="h-4 w-4 shrink-0 text-primary-700" />
            {unsold.name}
          </a>
        </li>
        <li class="col-span-2 m-0 px-3 pt-1">
          <a href="/product-groups" class="link-arrow text-sm font-semibold">All product groups</a>
        </li>
      </ul>
    </details>

    <a
      href="https://docs.odal-node.io"
      rel="noopener"
      class="block rounded-md px-3 py-2.5 text-sm font-medium text-neutral-700 no-underline hover:bg-neutral-100"
    >
      Docs<ExternalArrow class="ml-1" />
    </a>
    <Button href="/waitlist" class="mt-2 w-full">Join the waitlist</Button>
  </div>
</header>

<style>
  .dd-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-neutral-600);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .dd-trigger:hover,
  .dd-trigger[aria-expanded="true"] {
    background: color-mix(in srgb, var(--color-neutral-200) 60%, transparent);
    color: var(--color-neutral-900);
  }
  .dd-trigger.is-current {
    color: var(--color-primary-900);
  }
  .dd-chevron {
    width: 0.9rem;
    height: 0.9rem;
    opacity: 0.6;
    transition: transform 200ms ease;
  }
  .dd-trigger[aria-expanded="true"] .dd-chevron {
    transform: rotate(180deg);
  }

  /* Closed panels stay in the layout so they can fade, but take no pointer
     and are skipped by assistive technology (visibility: hidden). */
  .dd-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease, visibility 0s linear 160ms;
  }
  .dd[data-open="true"] > .dd-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 160ms ease, transform 160ms ease, visibility 0s;
  }
  .dd-mega {
    transform: translateY(-4px);
  }

  .dd-item {
    transition: background-color 150ms;
  }
  .dd-item:hover,
  .dd-item:focus-visible,
  .dd-item[aria-current="page"] {
    background: var(--color-primary-50);
  }
  .dd-tile {
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--color-primary-50);
    color: var(--color-primary-700);
    box-shadow: inset 0 0 0 1px var(--color-primary-100);
    transition: background-color 150ms, color 150ms, box-shadow 150ms;
  }
  .dd-item:hover .dd-tile,
  .dd-item:focus-visible .dd-tile,
  .dd-item[aria-current="page"] .dd-tile {
    background: var(--color-primary-700);
    color: #fff;
    box-shadow: none;
  }

  .m-section {
    border-bottom: 1px solid var(--color-neutral-100);
  }
  .m-section > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-neutral-900);
    cursor: pointer;
    list-style: none;
  }
  .m-section > summary::-webkit-details-marker {
    display: none;
  }
  .m-section > summary::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    opacity: 0.5;
    transition: transform 200ms ease;
  }
  .m-section[open] > summary::after {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .dd-panel,
    .dd[data-open="true"] > .dd-panel,
    .dd-chevron {
      transition: none;
    }
  }
</style>

<script>
  // Mobile panel.
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  // Desktop menus.
  const menus = Array.from(document.querySelectorAll<HTMLElement>("[data-dd]"));
  const hoverable = window.matchMedia("(hover: hover) and (pointer: fine)");
  const timers = new WeakMap<HTMLElement, number>();
  const hoverOpenedAt = new WeakMap<HTMLElement, number>();

  function setOpen(dd: HTMLElement, open: boolean) {
    dd.dataset.open = String(open);
    dd.querySelector(".dd-trigger")?.setAttribute("aria-expanded", String(open));
  }
  function closeAll(except?: HTMLElement) {
    for (const dd of menus) if (dd !== except) setOpen(dd, false);
  }

  for (const dd of menus) {
    const trigger = dd.querySelector<HTMLButtonElement>(".dd-trigger");
    trigger?.addEventListener("click", () => {
      // A mouse reaches the button by hovering it, which has already opened
      // the panel. The click that follows must not read as "close".
      const justHovered = Date.now() - (hoverOpenedAt.get(dd) ?? 0) < 600;
      const open = justHovered || dd.dataset.open !== "true";
      closeAll(dd);
      setOpen(dd, open);
    });

    // A short delay on leave, so crossing the gap between the button and its
    // panel does not close the panel.
    dd.addEventListener("mouseenter", () => {
      if (!hoverable.matches) return;
      window.clearTimeout(timers.get(dd));
      closeAll(dd);
      if (dd.dataset.open !== "true") hoverOpenedAt.set(dd, Date.now());
      setOpen(dd, true);
    });
    dd.addEventListener("mouseleave", () => {
      if (!hoverable.matches) return;
      timers.set(dd, window.setTimeout(() => setOpen(dd, false), 160));
    });

    // Tabbing out of a menu closes it.
    dd.addEventListener("focusout", (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !dd.contains(next)) setOpen(dd, false);
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = menus.find((dd) => dd.dataset.open === "true");
    if (!open) return;
    setOpen(open, false);
    open.querySelector<HTMLButtonElement>(".dd-trigger")?.focus();
  });
  document.addEventListener("click", (e) => {
    if (!menus.some((dd) => dd.contains(e.target as Node))) closeAll();
  });
</script>
