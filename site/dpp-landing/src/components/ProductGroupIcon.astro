---
// ProductGroupIcon.astro — one line icon per product group, keyed by the
// manifest key. Drawn here rather than pulled from an icon set, so the site
// carries no icon dependency and no third-party licence. Stroke is
// currentColor, so the icon takes the colour of whatever it sits in.
interface Props {
  group: string;
  class?: string;
}
const { group, class: extra = "" } = Astro.props;

const paths: Record<string, string> = {
  battery:
    '<rect x="2.5" y="7" width="17" height="10" rx="2"/><path d="M21.5 10.5v3M6.5 10v4M10 10v4"/>',
  textile:
    '<path d="M9 3.5 4 6l1.5 4H8v10.5h8V10h2.5L20 6l-5-2.5c-.5 1.5-1.6 2.5-3 2.5S9.5 5 9 3.5Z"/>',
  steel: '<path d="M4 4.5h16M4 19.5h16M12 4.5v15M9 4.5v2M15 4.5v2M9 17.5v2M15 17.5v2"/>',
  aluminium:
    '<path d="M3.5 19h17l-2.5-6H6l-2.5 6Z"/><path d="M7.5 13 9 8.5h6l1.5 4.5"/>',
  tyre: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21"/>',
  furniture:
    '<path d="M7 3.5v8.5M17 3.5v8.5M7 6.5h10"/><path d="M5 12h14v3H5z"/><path d="M6.5 15v5.5M17.5 15v5.5"/>',
  mattress:
    '<rect x="3" y="8.5" width="18" height="7.5" rx="2"/><path d="M5 16v3M19 16v3M7 12.25h10"/>',
  electronics: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  toy: '<rect x="3" y="12.5" width="8" height="8" rx="1.5"/><rect x="13" y="12.5" width="8" height="8" rx="1.5"/><rect x="8" y="3.5" width="8" height="8" rx="1.5"/>',
  detergent:
    '<path d="M10 2.5h4v3h-4z"/><path d="M9 5.5h6l2 4V20a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 20V9.5l2-4Z"/><path d="M7 13h10"/>',
  construction:
    '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 9.7h18M3 14.3h18M9 5v4.7M15 5v4.7M6 9.7v4.6M12 9.7v4.6M18 9.7v4.6M9 14.3V19M15 14.3V19"/>',
  "unsold-goods":
    '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9Z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={extra}
  set:html={paths[group] ?? paths["unsold-goods"]}
/>
