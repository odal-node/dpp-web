---
// Footer.astro — closing trust signals on the navy band. No newsletter, no social row.
// Uses the shared brand mark (currentColor variant) tinted ice for the dark band,
// so it stays in sync with the asset instead of a hand-rolled inline copy.
//
// Every column comes from lib/site-map.ts (the nav's menus) and
// lib/product-groups.ts, so a page reachable from the nav is reachable from the
// foot of every page too, and the two cannot drift. It spans the full width,
// with the same side padding as the nav bar, so its edges line up with the
// logo and the waitlist button above.
import OdalMark from "../assets/favicon.svg";
import ExternalArrow from "./ExternalArrow.astro";
import { menus, footerLinks } from "../lib/site-map";
import { groups, unsoldGoods } from "../lib/product-groups";

const year = new Date().getFullYear();
const link = (href: string) => footerLinks.find((e) => e.href === href)!;
const bottom = [link("/privacy"), link("/sitemap")];
---

<footer class="bg-primary-900 text-primary-200">
  <div class="grid grid-cols-2 gap-x-6 gap-y-10 px-4 py-14 text-sm sm:grid-cols-3 sm:px-6 lg:grid-cols-6 xl:grid-cols-[1.3fr_repeat(4,1fr)_2fr] xl:gap-x-8">
    <div class="col-span-2 sm:col-span-3 lg:col-span-6 xl:col-span-1">
      <p class="mb-2 flex items-center gap-2 font-semibold text-white">
        <OdalMark aria-hidden="true" class="h-6 w-6 shrink-0 text-primary-300" />
        Odal Node
      </p>
      <p class="leading-body text-primary-300">
        Signed by you. Verified by anyone.
      </p>
      <p class="mt-2 leading-body text-primary-300/80">
        Sovereign Digital Product Passport infrastructure
      </p>
    </div>

    {menus.map((m) => (
      <div>
        <p class="mb-3 font-semibold text-white">{m.label}</p>
        <ul class="m-0 list-none space-y-2 p-0">
          {m.items.map((e) => (
            <li>
              <a class="text-primary-200 hover:text-white" href={e.href} rel={e.external ? "noopener" : undefined}>
                {e.label}{e.external && <ExternalArrow class="ml-1" />}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="col-span-2 sm:col-span-3 lg:col-span-2 xl:col-span-1">
      <p class="mb-3 font-semibold text-white">
        <a class="text-white hover:text-primary-200" href="/product-groups">Product groups</a>
      </p>
      <ul class="m-0 list-none columns-2 gap-x-6 p-0 sm:columns-3 lg:columns-2">
        {[...groups, unsoldGoods].map((g) => (
          <li class="mb-2 break-inside-avoid">
            <a class="text-primary-200 hover:text-white" href={`/product-groups/${g.key}`}>{g.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-primary-800">
    <div class="flex flex-col gap-3 px-4 py-4 text-xs text-primary-300/70 sm:flex-row sm:justify-between sm:px-6">
      <p class="m-0 flex flex-wrap gap-x-5 gap-y-2">
        <span>&copy; {year} Odal Node</span>
        {bottom.map((e) => (
          <a class="text-primary-300/70 hover:text-primary-200" href={e.href}>{e.label}</a>
        ))}
      </p>
      <p class="m-0">
        <a class="text-primary-300/70 hover:text-primary-200" href="https://github.com/odal-node" rel="noopener">github.com/odal-node<ExternalArrow class="ml-1" /></a>
      </p>
    </div>
  </div>
</footer>
