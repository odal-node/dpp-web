---
// Footer.astro — closing trust signals on the navy band. No newsletter, no social row.
// Uses the shared brand mark (currentColor variant) tinted ice for the dark band,
// so it stays in sync with the asset instead of a hand-rolled inline copy.
import OdalMark from "../assets/favicon.svg";
const year = new Date().getFullYear();
---

<footer class="bg-primary-900 text-primary-200">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-12 text-sm sm:grid-cols-2 sm:px-6 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-4">
      <p class="mb-2 flex items-center gap-2 font-semibold text-white">
        <OdalMark aria-hidden="true" class="h-6 w-6 shrink-0 text-primary-300" />
        Odal Node
      </p>
      <p class="leading-body text-primary-300">
        Signed by you. Verified by anyone.
      </p>
      <p class="mt-2 leading-body text-primary-300/80">
        Sovereign Digital Product Passport infrastructure for EU ESPR.
      </p>
      <!-- <p class="mt-3 leading-body text-primary-300/80">
        Apache-2.0 core — anyone may build on it.
      </p> -->
    </div>

    <!-- The pages the nav deliberately does not carry. Each is read once and
         then referred back to, which is a footer job rather than a nav one. -->
    <div class="lg:col-span-3">
      <p class="mb-2 font-semibold text-white">Explore</p>
      <ul class="m-0 list-none space-y-1 p-0">
        <li><a class="text-primary-200 hover:text-white" href="/lifecycle">The chain of custody</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/who-sees-what">Who sees what</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/roadmap">Roadmap</a></li>
      </ul>
    </div>

    <!-- One route, not twelve links. The index page counts and lists them from
         the same vendored manifests the pages themselves are generated from. -->
    <div class="lg:col-span-2">
      <p class="mb-2 font-semibold text-white">Product groups</p>
      <ul class="m-0 list-none space-y-1 p-0">
        <li><a class="text-primary-200 hover:text-white" href="/product-groups">All product groups</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <p class="mb-2 font-semibold text-white">Project</p>
      <ul class="m-0 list-none space-y-1 p-0">
        <li><a class="text-primary-200 hover:text-white" href="https://github.com/odal-node/dpp-core">dpp-core on GitHub</a></li>
        <li><a class="text-primary-200 hover:text-white" href="https://github.com/odal-node/dpp-engine">dpp-engine on GitHub</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/privacy">Privacy policy</a></li>
        <li><a class="text-primary-200 hover:text-white" href="https://github.com/odal-node/dpp-engine/blob/main/SECURITY.md">Security policy</a></li>
      </ul>
    </div>

  </div>

  <div class="border-t border-primary-800">
    <div class="mx-auto flex max-w-6xl px-4 py-4 text-xs text-primary-300/70 flex-row justify-between sm:px-6 lg:px-8">
      <p class="m-0">
        &copy; {year} Odal Node
      </p>
      <p class="m-0">
        <a class="text-primary-300/70 hover:text-primary-200" href="https://github.com/odal-node">github.com/odal-node</a>
      </p>
    </div>
  </div>
</footer>
