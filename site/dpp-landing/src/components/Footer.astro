---
// Footer.astro — closing trust signals on the navy band. No newsletter, no social row.
// Uses the shared brand mark (currentColor variant) tinted ice for the dark band,
// so it stays in sync with the asset instead of a hand-rolled inline copy.
import OdalMark from "../assets/favicon.svg";
import ExternalArrow from "./ExternalArrow.astro";
const year = new Date().getFullYear();
---

<footer class="bg-primary-900 text-primary-200">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-12 text-sm sm:grid-cols-2 sm:px-6 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-3">
      <p class="mb-2 flex items-center gap-2 font-semibold text-white">
        <OdalMark aria-hidden="true" class="h-6 w-6 shrink-0 text-primary-300" />
        Odal Node
      </p>
      <p class="leading-body text-primary-300">
        Signed by you. Verified by anyone.
      </p>
      <p class="mt-2 leading-body text-primary-300/80">
        Sovereign Digital Product Passport infrastructure
      </p>
    </div>

    <!-- Mirrors the nav's three menus, in the same order, so the same pages
         are reachable from the foot of every page. -->
    <div class="lg:col-span-2">
      <p class="mb-2 font-semibold text-white">How it works</p>
      <ul class="m-0 list-none space-y-2 p-0">
        <li><a class="text-primary-200 hover:text-white" href="/lifecycle">Lifecycle</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/visibility">Visibility</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/example-passport">Example passport</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/verify">Verify</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <p class="mb-2 font-semibold text-white">Resources</p>
      <ul class="m-0 list-none space-y-2 p-0">
        <li><a class="text-primary-200 hover:text-white" href="/build-on-odal">Build on Odal</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/regulations">Regulations</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/timeline">Timeline</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/passport-check">Passport check</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/roadmap">Roadmap</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/faq">FAQ</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/glossary">Glossary</a></li>
      </ul>
    </div>

    <!-- One link here; the nav's Product groups menu lists every group. -->
    <div class="lg:col-span-2">
      <p class="mb-2 font-semibold text-white">Product groups</p>
      <ul class="m-0 list-none space-y-2 p-0">
        <li><a class="text-primary-200 hover:text-white" href="/product-groups">All product groups</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <p class="mb-2 font-semibold text-white">Privacy &amp; security</p>
      <ul class="m-0 list-none space-y-2 p-0">
        <li><a class="text-primary-200 hover:text-white" href="/trust">What Odal can see</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/privacy">Privacy policy</a></li>
        <li><a class="text-primary-200 hover:text-white" href="/security">Security</a></li>
      </ul>
    </div>

  </div>

  <div class="border-t border-primary-800">
    <div class="mx-auto flex max-w-6xl px-4 py-4 text-xs text-primary-300/70 flex-row justify-between sm:px-6 lg:px-8">
      <p class="m-0">
        &copy; {year} Odal Node
      </p>
      <p class="m-0">
        <a class="text-primary-300/70 hover:text-primary-200" href="https://github.com/odal-node" rel="noopener">github.com/odal-node<ExternalArrow class="ml-1" /></a>
      </p>
    </div>
  </div>
</footer>
