---
// /glossary — plain explanations of the terms the site and the law use.
// Content lives in src/data/glossary.json; this page lays it out and emits the
// same definitions as DefinedTermSet structured data.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ExternalArrow from "../components/ExternalArrow.astro";
import glossary from "../data/glossary.json";

type Term = { term: string; definition: string; link?: { href: string; label: string } };
const terms = glossary.terms as Term[];

const title = "Glossary: Digital Product Passport terms | Odal Node";
const description =
  "Plain explanations of the terms around EU Digital Product Passports: product groups, delegated acts, legitimate interest, electronic seals, proof files and more.";

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
// Each letter links to the first term under it.
const initial = (t: Term) => t.term[0].toUpperCase();
const letters = [...new Set(terms.map(initial))].map((letter) => ({
  letter,
  target: slug(terms.find((t) => initial(t) === letter)!.term),
}));
const external = (href: string) => /^https?:\/\//.test(href);

const termSetLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Digital Product Passport glossary",
  url: "https://odal-node.io/glossary",
  hasDefinedTerm: terms.map((t) => ({
    "@type": "DefinedTerm",
    name: t.term,
    description: t.definition,
    url: `https://odal-node.io/glossary#${slug(t.term)}`,
  })),
};
---

<Base title={title} description={description} jsonLd={[termSetLd]}>
  <Section h1 eyebrow="Glossary" title="The words around a passport, explained." wide>
    <p>
      Short, plain explanations of the terms this site and the law use. Each
      links to the page that shows it in context.
    </p>
    <nav aria-label="Jump to letter" class="not-prose mt-2 flex flex-wrap gap-1.5">
      {letters.map((l) => (
        <a
          href={`#${l.target}`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-neutral-200 bg-white text-sm font-semibold text-neutral-800 no-underline hover:border-primary-300 hover:no-underline"
        >
          {l.letter}
        </a>
      ))}
    </nav>
  </Section>

  <Section eyebrow="A to Z" title="Terms." tone="muted" wide>
    <dl class="not-prose m-0 grid gap-4 md:grid-cols-2">
      {terms.map((t) => {
        return (
          <div id={slug(t.term)} class="card m-0 scroll-mt-24 p-5">
            <dt class="text-base font-semibold text-neutral-900">{t.term}</dt>
            <dd class="m-0 mt-1.5 text-sm leading-relaxed text-neutral-700">{t.definition}</dd>
            {t.link && (
              <dd class="m-0 mt-3 text-sm">
                {external(t.link.href) ? (
                  <a href={t.link.href} rel="noopener" class="font-medium">{t.link.label}<ExternalArrow class="ml-1" /></a>
                ) : (
                  <a href={t.link.href} class="link-arrow">{t.link.label}</a>
                )}
              </dd>
            )}
          </div>
        );
      })}
    </dl>
  </Section>

  <Section eyebrow="More" title="Still have a question?" tone="tinted">
    <p>
      The <a href="/faq">FAQ</a> answers the questions people ask first, and
      the <a href="https://docs.odal-node.io" rel="noopener">documentation</a>{" "}
      covers the technical side.
    </p>
  </Section>
</Base>
