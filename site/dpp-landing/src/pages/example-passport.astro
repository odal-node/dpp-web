---
// /example-passport — one realistic battery passport, sorted by who may read
// each part. The data and the sorting live in lib/example-passport.ts, shared
// with the home page's passport preview.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { fieldLabel } from "../lib/product-groups";
import { buckets, flat, isObj, scalar, shown } from "../lib/example-passport";

const title = "Example battery passport | Odal Node";
const description =
  "An example of an electric-vehicle battery passport, sorted into what anyone can read, what authorities and readers with a legitimate interest can read, and what only one of them can.";

const SECTIONS = [
  {
    key: "public",
    eyebrow: "Anyone who scans",
    title: "The public part.",
    note: "No login and no fee. This is what a phone camera opens.",
  },
  {
    key: "restricted",
    eyebrow: "Authorities and readers with a legitimate interest",
    title: "Held back for credential holders.",
    note: "Dismantling and composition detail, shown to authorities and to readers with a legitimate interest, such as repairers and recyclers.",
  },
  {
    key: "conformity",
    eyebrow: "Authorities only",
    title: "The evidence of conformity.",
    note: "Test results, shown to notified bodies, market surveillance authorities and the Commission.",
  },
  {
    key: "individual",
    eyebrow: "Readers with a legitimate interest only",
    title: "This battery's own history.",
    note: "State of health and use, shown to readers with a legitimate interest and not to authorities.",
  },
];

---

<Base title={title} description={description}>
  <Section h1 eyebrow="Example" title="An example battery passport." wide>
    <p>
      This is a passport for an electric-vehicle battery, from the software's
      own example data. The company, <strong>Musterzelle GmbH</strong>, is
      invented, and the page shows the data a company submits before it is
      signed, sorted the way a node shows it to each reader.
    </p>
    <p>
      Some public values are placeholders. For passports from February 2027,
      the Commission's guidance says to leave the carbon footprint and the
      shares of recycled cobalt, lithium, nickel and lead empty until the rules
      for calculating and showing them apply. The software still asks for
      them, and that is being changed. Information on responsible sourcing is
      due from August 2027, so it is not shown here.
    </p>
    <p>
      To see a signed proof file checked in your browser, use{" "}
      <a href="/verify">Verify</a>. To switch between readers and watch the parts
      change, use <a href="/visibility">Visibility</a>.
    </p>
  </Section>

  {SECTIONS.map((s, i) => {
    const rows = (buckets[s.key] ?? []).filter(([, v]) => v !== null && !(Array.isArray(v) && v.length === 0));
    return (
      <Section eyebrow={s.eyebrow} title={s.title} tone={i % 2 === 0 ? "muted" : "default"} wide>
        <p>{s.note}</p>
        <dl class="not-prose mt-6 grid gap-px overflow-hidden rounded-xl border border-neutral-200 bg-neutral-200 md:grid-cols-2">
          {rows.map(([k, v]) => (
            <div class="bg-white p-4">
              <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{fieldLabel(k)}</dt>
              <dd class="m-0 mt-1 text-sm text-neutral-800">
                {Array.isArray(v) ? (
                  v.every((x) => !isObj(x)) ? (
                    v.map(scalar).join(", ")
                  ) : (
                    <ul class="m-0 list-none space-y-1 p-0">
                      {v.map((x) => <li class="m-0">{isObj(x) ? flat(x) : scalar(x)}</li>)}
                    </ul>
                  )
                ) : isObj(v) ? (
                  flat(v)
                ) : (
                  shown(k, v)
                )}
              </dd>
            </div>
          ))}
        </dl>
      </Section>
    );
  })}

  <Section eyebrow="Read this first" title="What this example is." tone="tinted">
    <p>
      The fields and who may read them are the software's own, for a battery
      under the Batteries Regulation. The values are invented. A field the
      software does not list as restricted is shown publicly, which is why the
      public part is the largest.
    </p>
    <p><a href="/product-groups/battery" class="link-arrow">The battery product group</a></p>
  </Section>
</Base>
