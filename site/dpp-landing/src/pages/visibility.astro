---
// /visibility — the Art. 77(2) access lattice, operated rather than asserted.
//
// The point of this page is that a visitor changes the audience and watches
// fields appear and vanish. A table of the same information is a claim; a
// mechanism someone drives is an argument.
//
// The headline says the two audiences see *different* things, never that one
// sees less: authorities get point 3 and not point 4, legitimate interest gets
// point 4 and not point 3. "An authority sees less than a recycler" was the
// earlier headline, and it is false without the qualifier.
//
// SCOPE: batteries only, and the page says so in three places. ESPR Art. 11(b)
// defers access rights to each product group's own delegated act, so a general
// claim would assert a rule that exists for one product group.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import access from "../data/access.json";

const title = "Visibility: who sees which part of a battery passport | Odal Node";
const description =
  "The battery passport's access rules are not a ladder: an authority and a recycler each see something the other cannot. Pick a reader and watch the parts of the passport change.";
---

<Base title={title} description={description}>
  <Section
    eyebrow="Visibility"
    title="An authority and a recycler see different things."
    wide
  >
    <p>
      Each can see something the other cannot. That surprises people, so here
      is the mechanism rather than the claim: pick a reader below and watch
      which parts of the passport appear.
    </p>
    <p>
      Everything on this page comes from <strong>Regulation (EU) 2023/1542,
      Art. 77(2)</strong> and <strong>Annex XIII</strong>, quoted from the
      consolidated text. It covers the <em>battery</em> passport only; the note
      at the foot of the page explains why that matters.
    </p>

    <div class="not-prose mt-10">
      <!-- A grid, not flex-wrap: three choices of unequal label length wrapped
           two-then-one at most widths, which reads as three unrelated buttons
           rather than one control with three positions. -->
      <div role="group" aria-label="Choose an audience" class="grid gap-3 sm:grid-cols-3">
        {access.audiences.map((a, i) => (
          <button
            type="button"
            data-sees={a.sees.join(",")}
            data-basis={a.basis}
            aria-pressed={i === 0 ? "true" : "false"}
            class="audience-btn card px-4 py-3"
          >
            <span class="block text-sm font-semibold">{a.label}</span>
            <span class="block text-xs opacity-70">{a.sub}</span>
          </button>
        ))}
      </div>

      <p class="mt-4 text-sm text-neutral-600">
        Legal basis: <span id="basis">{access.audiences[0].basis}</span>
      </p>

      <ul class="mt-8 space-y-4">
        {access.points.map((p) => {
          // Rendered for the first audience on the server, so the page reads
          // correctly before (or without) the script.
          const shown = access.audiences[0].sees.includes(p.id);
          return (
          <li
            data-point={p.id}
            data-visible={shown ? "true" : "false"}
            class:list={["point", "card", "p-5", { "opacity-40": !shown }]}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-base font-semibold text-neutral-900">{p.title}</h3>
              <span class:list={["state shrink-0 rounded px-2 py-1 text-xs font-semibold", shown ? "bg-primary-100 text-primary-800" : "bg-neutral-100 text-neutral-500"]}>
                {shown ? "Visible" : "Withheld"}
              </span>
            </div>
            <p class="mt-2 text-sm text-neutral-700">{p.note}</p>
            {p.only === "authority" && (
              <p class="mt-2 text-xs font-semibold text-primary-700">
                Authorities only. Not shown to a recycler.
              </p>
            )}
            {p.only === "legitimate" && (
              <p class="mt-2 text-xs font-semibold text-primary-700">
                Legitimate interest only. Not shown to an authority.
              </p>
            )}
          </li>
          );
        })}
      </ul>
    </div>
  </Section>

  <Section eyebrow="Why it is not a ladder" title="Neither reader sees everything the other sees." tone="muted" wide>
    <p>
      Art. 77(2) gives <strong>points 2 and 3</strong> to notified bodies,
      market surveillance authorities and the Commission, and{" "}
      <strong>points 2 and 4</strong> to readers with a legitimate interest.
    </p>
    <p>
      Point 3 is missing from the second list. Point 4 is missing from the
      first. No ranking can express that, so no simple access level can either.
      Software that puts the regulator at the top of a ladder gives the wrong
      answer for point 4.
    </p>
    <p>
      Point 4 is the individual battery's own use history: charge cycles,
      accidents, temperature, state of charge. For an electric vehicle that is a
      usage record of an identifiable vehicle. Showing it to a reader the law
      does not grant it to is a personal-data disclosure, not a display bug.
    </p>
  </Section>

  <Section eyebrow="Scope" title="This is the battery passport, and only the battery passport." wide>
    <p>
      ESPR does not impose this split. <strong>Art. 11(b)</strong> gives each
      reader access <em>"based on their respective access rights set out in the
      applicable delegated act adopted pursuant to Article 4"</em>, so who sees
      what belongs to each product group's own rules.
    </p>
    <p>
      For batteries, the Battery Regulation sets the split itself, and it is
      quoted above. For textiles, electronics, furniture and most other groups,{" "}
      <strong>no such rules have been adopted</strong>, so there is no split
      between authorities and legitimate interest to show. We model that as
      absence rather than guessing: each product group carries only the access
      rules its own law defines.
    </p>
    <p>
      One fixed set of access levels, applied everywhere, would treat one
      product group's rule as if it were the whole regulation's.
    </p>
  </Section>
</Base>

<script>
  // Each audience button carries what it may see (data-sees) and its legal
  // basis (data-basis), so the script needs no data of its own.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".audience-btn"));
  const points = Array.from(document.querySelectorAll<HTMLElement>(".point"));
  const basisEl = document.getElementById("basis");

  const SHOWN = ["bg-primary-100", "text-primary-800"];
  const HIDDEN = ["bg-neutral-100", "text-neutral-500"];

  function apply(active: HTMLButtonElement) {
    const visible = new Set((active.dataset.sees ?? "").split(","));
    for (const b of buttons) b.setAttribute("aria-pressed", String(b === active));
    if (basisEl) basisEl.textContent = active.dataset.basis ?? "";

    for (const p of points) {
      const shown = visible.has(p.dataset.point ?? "");
      p.classList.toggle("opacity-40", !shown);
      p.dataset.visible = String(shown);
      const state = p.querySelector(".state");
      if (state) {
        state.textContent = shown ? "Visible" : "Withheld";
        state.classList.remove(...SHOWN, ...HIDDEN);
        state.classList.add(...(shown ? SHOWN : HIDDEN));
      }
    }
  }

  for (const b of buttons) b.addEventListener("click", () => apply(b));
</script>
