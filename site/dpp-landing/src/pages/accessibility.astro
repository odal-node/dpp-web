---
// /accessibility — the accessibility statement.
//
// The automated check ran on 2026-09-26: axe-core 4.10.3 (WCAG 2.0, 2.1 and
// 2.2 A and AA rules, plus its best-practice rules) against every published
// page of this site at 1280px and 375px, and against ten pages of the
// documentation site. Every finding was fixed and a re-run was clean.
//
// On 2026-09-27 axe-core 4.13 ran on every page of both sites at both widths,
// and every page was walked with Tab alone in headless Chromium (see README).
//
// 🚨 No person has tested the site by hand yet, with a screen reader or with a
// keyboard alone, and the page says so (founder's call, 2026-09-29, so the
// site can be promoted before that pass). When the pass is done, say so here
// and change the section title back.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";

const reviewed = "2026-09-26";
const reviewedText = new Date(`${reviewed}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const mailto = `mailto:contact@odal-node.io?subject=${encodeURIComponent("Accessibility")}`;

const title = "Accessibility | Odal Node";
const description =
  "The accessibility standard the Odal Node website aims for, how it is checked, and how to tell us about a problem.";
---

<Base title={title} description={description}>
  <Section h1 eyebrow="Accessibility" title="This site should work for everyone who needs it.">
    <p>
      We aim for level AA of the Web Content Accessibility Guidelines (WCAG)
      2.2, on this website and on the documentation site.
    </p>
    <p class="text-sm text-neutral-600">
      Last reviewed <time datetime={reviewed}>{reviewedText}</time>.
    </p>
  </Section>

  <Section eyebrow="How it is checked" title="By an automated checker, not yet by hand." tone="muted">
    <p>
      Every page of this site and of the documentation site has been checked
      with axe-core, a widely used automated accessibility checker, at desktop
      and phone widths. Every page has also been stepped through with the Tab
      key in an automated browser, to check that each control can be reached
      and shows where the focus is.
    </p>
    <p>
      An automated check finds only part of what makes a site hard to use. We
      have not yet tested the site by hand, with a screen reader or by a person
      using only a keyboard. That is the next step.
    </p>
  </Section>

  <Section eyebrow="Tell us" title="Found something that does not work for you?" tone="tinted">
    <p>
      Email us with the page, what you were trying to do and what happened. We
      will reply, and fix it or say when we can.
    </p>
    <div class="not-prose mt-6 flex flex-wrap gap-3">
      <Button href={mailto}>Email contact@odal-node.io</Button>
    </div>
  </Section>
</Base>
