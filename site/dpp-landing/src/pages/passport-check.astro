---
// /passport-check — "Does my product need a passport?"
//
// Every answer is worked out at build time in lib/checker.ts from the same
// records as /regulations and /timeline. Without JavaScript the page lists every
// answer; the script turns the list into a one- or two-step picker and keeps
// the choice in the address so an answer can be shared.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import BasisMark from "../components/BasisMark.astro";
import Button from "../components/Button.astro";
import { choices, type Answer } from "../lib/checker";
import { basisLabel } from "../lib/regulations";

const title = "Does my product need a Digital Product Passport? | Odal Node";
const description =
  "Pick what you make or sell and see whether EU law requires a Digital Product Passport for it, from when, and where that date comes from.";

type Card = { key: string; label: string; answer: Answer };
const cards: Card[] = choices.flatMap((c) =>
  c.follow
    ? c.follow.options.map((o) => ({ key: `${c.key}:${o.key}`, label: `${c.label}: ${o.label}`, answer: o.answer }))
    : c.answer
      ? [{ key: c.key, label: c.label, answer: c.answer }]
      : [],
);

const tone = {
  yes: "border-regulatory-border bg-regulatory-bg",
  later: "border-primary-200 bg-primary-50",
  no: "border-neutral-200 bg-white",
};
const selectClass =
  "mt-2 block w-full max-w-md rounded-md border border-neutral-300 bg-white px-3 py-2.5 text-base text-neutral-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200";
---

<Base title={title} description={description}>
  <Section h1 eyebrow="Passport check" title="Does my product need a passport?" wide>
    <p>
      Pick what you make or sell. The answer comes from the same legal records
      as the rest of this site, and says where its date comes from. It is a
      first answer to point you to the right act, not legal advice.
    </p>

    <div id="pc" class="not-prose mt-6">
      <form id="pc-form" class="space-y-5" hidden>
        <div>
          <label for="pc-group" class="text-sm font-semibold text-neutral-900">What do you make or sell?</label>
          <select id="pc-group" class={selectClass}>
            <option value="">Choose one</option>
            {choices.map((c) => <option value={c.key}>{c.label}</option>)}
          </select>
        </div>
        {choices.filter((c) => c.follow).map((c) => (
          <div data-follow={c.key} hidden>
            <label for={`pc-follow-${c.key}`} class="text-sm font-semibold text-neutral-900">{c.follow!.question}</label>
            <select id={`pc-follow-${c.key}`} class={selectClass}>
              <option value="">Choose one</option>
              {c.follow!.options.map((o) => <option value={o.key}>{o.label}</option>)}
            </select>
          </div>
        ))}
      </form>

      <ul id="pc-answers" class="m-0 mt-6 grid list-none gap-4 p-0" aria-live="polite">
        {cards.map((c) => (
          <li data-answer={c.key} class:list={["m-0 max-w-2xl rounded-md border p-5", tone[c.answer.verdict]]}>
            <p class="m-0 text-xs font-semibold uppercase tracking-wide text-neutral-500">{c.label}</p>
            <p class="m-0 mt-1.5 text-xl font-semibold leading-snug text-neutral-900">{c.answer.headline}</p>
            <p class="m-0 mt-2 text-sm leading-body text-neutral-700">{c.answer.detail}</p>
            <p class="m-0 mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
              {c.answer.basis && <BasisMark basis={c.answer.basis} label={basisLabel(c.answer.basis)} />}
              {c.answer.links.map((l) => <a href={l.href} class="link-arrow">{l.label}</a>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section eyebrow="What the answer means" title="Who the passport is for, and what comes next." tone="muted">
    <p>
      The duty sits with whoever places the product on the EU market, usually
      the manufacturer. Where a passport is required, it has to exist before
      the product is sold, and stay available for years afterwards.
    </p>
    <p>
      Where the answer is "not yet", the Commission has not adopted the act
      that sets the rules. The <a href="/timeline">timeline</a> shows when each
      act is planned, and the answer here changes when one is adopted.
    </p>
  </Section>

  <Section eyebrow="Next step" title="Getting ready before the date." tone="tinted">
    <p>
      Odal Node is software you run yourself to issue, sign and publish your
      passports. Join the waitlist to hear when it is ready for your product
      group.
    </p>
    <div class="not-prose mt-6 flex flex-wrap gap-3">
      <Button href="/waitlist">Join the waitlist</Button>
      <Button href="/faq" variant="secondary">Read the FAQ</Button>
    </div>
  </Section>
</Base>

<script>
  const root = document.getElementById("pc");
  const form = document.getElementById("pc-form");
  const group = document.getElementById("pc-group") as HTMLSelectElement | null;
  if (root && form && group) {
    const follows = [...root.querySelectorAll<HTMLElement>("[data-follow]")];
    const answers = [...root.querySelectorAll<HTMLElement>("[data-answer]")];
    const followSelect = (f: HTMLElement) => f.querySelector("select") as HTMLSelectElement;

    const show = () => {
      let key = group.value;
      for (const f of follows) {
        const on = f.dataset.follow === group.value;
        f.hidden = !on;
        if (on) key = followSelect(f).value ? `${group.value}:${followSelect(f).value}` : "";
      }
      for (const a of answers) a.hidden = a.dataset.answer !== key;
      history.replaceState(null, "", key ? `#${key}` : location.pathname);
    };

    // An answer shared by its address opens on that answer.
    const [g, sub] = decodeURIComponent(location.hash.slice(1)).split(":");
    if (g && [...group.options].some((o) => o.value === g)) {
      group.value = g;
      const f = follows.find((x) => x.dataset.follow === g);
      if (f && sub) followSelect(f).value = sub;
    }

    form.hidden = false;
    form.addEventListener("submit", (e) => e.preventDefault());
    group.addEventListener("change", show);
    for (const f of follows) followSelect(f).addEventListener("change", show);
    show();
  }
</script>
