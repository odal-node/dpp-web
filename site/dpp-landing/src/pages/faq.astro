---
// /faq — short answers to the questions a manufacturer or compliance lead asks
// first. Content lives in src/data/faq.json; this page only lays it out and
// emits the same answers as FAQPage structured data, so search engines show
// exactly what the page says and nothing else.
//
// Each answer links to the page that shows the detail. The FAQ restates; it
// never becomes the only home of a claim.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ExternalArrow from "../components/ExternalArrow.astro";
import faq from "../data/faq.json";

type Item = { q: string; a: string[]; link?: { href: string; label: string } };
type Group = { title: string; items: Item[] };
const groups = faq.groups as Group[];

const title = "FAQ: Digital Product Passports and Odal Node | Odal Node";
const description =
  "Short answers on Digital Product Passports and Odal Node: which products need one and when, where your data lives, who can read it, what it costs and how ready it is.";

const external = (href: string) => /^https?:\/\//.test(href);

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: groups.flatMap((g) =>
    g.items.map((it) => ({
      "@type": "Question",
      name: it.q,
      acceptedAnswer: { "@type": "Answer", text: it.a.join(" ") },
    })),
  ),
};
---

<Base title={title} description={description} jsonLd={[faqLd]}>
  <Section h1 eyebrow="FAQ" title="Questions people ask first." wide>
    <p>
      Short answers, each with a link to the page that shows the detail.
    </p>
    <ul class="not-prose m-0 flex list-none flex-wrap gap-2 p-0">
      {groups.map((g, i) => (
        <li class="m-0">
          <a
            href={`#group-${i}-title`}
            class="inline-flex rounded-full border border-neutral-200 bg-white px-3.5 py-1.5 text-sm font-medium text-neutral-800 no-underline transition-colors hover:border-primary-300 hover:no-underline"
          >
            {g.title}
          </a>
        </li>
      ))}
    </ul>
  </Section>

  {groups.map((g, i) => (
    <Section id={`group-${i}`} eyebrow={`${i + 1} of ${groups.length}`} title={g.title} tone={i % 2 === 0 ? "muted" : "default"} wide>
      <div class="not-prose -mt-2 space-y-3">
        {g.items.map((it) => (
          <details class="faq card group m-0 p-0">
            <summary class="flex cursor-pointer items-start justify-between gap-4 p-5 text-base font-semibold text-neutral-900">
              <span>{it.q}</span>
              <svg class="faq-chevron mt-1 h-4 w-4 shrink-0 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="px-5 pb-5">
              {it.a.map((p) => (
                <p class="m-0 mb-3 max-w-3xl text-sm leading-relaxed text-neutral-700">{p}</p>
              ))}
              {it.link && (
                <p class="m-0 text-sm">
                  {external(it.link.href) ? (
                    <a href={it.link.href} rel="noopener" class="font-medium">
                      {it.link.label}<ExternalArrow class="ml-1" />
                    </a>
                  ) : (
                    <a href={it.link.href} class="link-arrow">{it.link.label}</a>
                  )}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </Section>
  ))}

  <Section eyebrow="More" title="Where to go next." tone="tinted" wide>
    <p>
      The{" "}
      <a href="https://docs.odal-node.io" rel="noopener">documentation</a>{" "}
      covers the technical side, and the <a href="/roadmap">roadmap</a> is
      updated whenever something moves.
    </p>
  </Section>
</Base>

<style>
  .faq > summary {
    list-style: none;
  }
  .faq > summary::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    transition: transform 200ms ease;
  }
  .faq[open] .faq-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
