{
  "name": "dpp-web",
  "description": "Workspace root for odal-node.io (dpp-landing) and docs.odal-node.io (dpp-docs).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:landing": "pnpm --filter dpp-landing dev",
    "dev:docs": "pnpm --filter dpp-docs dev",
    "build:landing": "pnpm --filter dpp-landing build",
    "build:docs": "pnpm --filter dpp-docs build",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "check:links": "node scripts/check-links.mjs",
    "check:spacing": "node scripts/check-inline-spacing.mjs",
    "check:leakage": "node scripts/check-leakage.mjs",
    "check:openapi": "pnpm --filter dpp-docs run check:openapi",
    "sync:openapi": "pnpm --filter dpp-docs run sync:openapi",
    "preview:landing": "pnpm --filter dpp-landing preview",
    "preview:docs": "pnpm --filter dpp-docs preview",
    "clean": "pnpm -r exec rm -rf dist .astro node_modules && rm -rf node_modules",
    "check:llms": "node scripts/check-llms-txt.mjs site/dpp-landing https://odal-node.io && node scripts/check-llms-txt.mjs site/dpp-docs https://docs.odal-node.io",
    "test:scripts": "node --test scripts/cloudflare-rate-limit.test.mjs",
    "rate-limit:verify": "node scripts/cloudflare-rate-limit.mjs"
  }
}
